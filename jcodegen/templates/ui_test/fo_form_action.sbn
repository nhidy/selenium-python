{{- include "common.sbn" }}
field_names_enabled = [
{{~ for field in field_list ~}}
    {{~ if field.is_enable == 'y' ~}}
    '{{ field.title }}',
    {{~ end ~}}
{{~ end ~}}
]

field_names_disabled = [
{{~ for field in field_list ~}}
    {{~ if field.is_enable == 'n' ~}}
    '{{ field.title }}',
    {{~ end ~}}
{{~ end ~}}
]

# {{ transaction_code }}: {{ form_title }}
def{{~ " " ~}}{{~ transaction_code | string.downcase ~}}{{~ "(self" ~}}
{{~ list_param = "" ~}}
{{~ for field in field_list ~}}
    {{~
    if field.value != ""
        value_param = field.value | string.append "=None"
        list_param = list_param | string.append ", " | string.append value_param
    ~}}
    {{~ end ~}}
{{~ end ~}}
{{ list_param }}{{ ", ifc_codes=None, values=None, total_fee=None, approve_later=None, approve_on_form=None, username=None, password=None, reason=None, list_error_message=None, expected_posting=None):" }}
    # open form
    self.close_all_form()
    self.open_fo('{{ transaction_code }}', '{{ transaction_name }}')
    self.wait_for_button_available('Accept')
    self.assert_form_title('{{ form_title }}')
    # enter value
{{~ for field in field_list ~}}
        {{~ fo_field_method = fo_get_field_method field.field_type field.is_enable field.is_group field.is_multi field.border_name ~}}
    {{~ method = choose_method fo_field_method ~}}
    {{~ if field.value != "" && fo_field_method != "" && field.is_enable == 'y' ~}}
        {{~ if field.value_input != "" ~}}
    if {{ field.value }} is None or {{ field.value }} == '':
        {{ field.value }} = {{ field.value_input }}
        {{~ end ~}}
        {{~ if field.title != "" ~}}
    {{ choose_param fo_field_method method field.title field.value field.collap_name field.border_name field.is_replace field.replace_by field.mask_method }}
            {{~ if field.is_wait == "y" ~}}
        self.wait_loading()
            {{~ end ~}}
        {{~ end ~}}
    {{~ end ~}}
{{~ end ~}}
{{~ if add_fee == "y" ~}}
    if ifc_codes:
        self.add_fees(ifc_codes, values, total_fee)
{{~ end ~}}
{{~ for field in field_list ~}}
    {{~ fo_field_method = fo_get_field_method field.field_type field.is_enable field.is_group field.is_multi field.border_name ~}}
    {{~ method = choose_method fo_field_method ~}}
    {{~ if field.value != "" && fo_field_method != "" && field.is_enable == 'n' ~}}
        {{~ if field.value_input != "" ~}}
    if {{ field.value }} is None or {{ field.value }} == '':
        {{ field.value }} = {{ field.value_input }}
        {{~ end ~}}
        {{~ if field.title != "" ~}}
    {{ choose_param fo_field_method method field.title field.value field.collap_name field.border_name field.is_replace field.replace_by field.mask_method }}
            {{~ if field.is_wait == "y" ~}}
        self.wait_loading()
            {{~ end ~}}
        {{~ end ~}}
    {{~ end ~}}
{{~ end ~}}
    self.wait_loading()
{{~ for field in field_list ~}}
    {{~ fo_field_method = fo_get_field_method field.field_type field.is_enable field.is_group field.is_multi field.border_name ~}}
    {{~ method = choose_method fo_field_method ~}}
    {{~ if field.value == "" && field.title != "" && field.collap_name == "" ~}}
    self.{{ method }}('{{ field.title }}')
    self.wait_loading()
    {{~ end ~}}
{{~ end ~}}
    # click 'Accept'
    self.click_button('Accept')
    # approve
    if approve_later=='Y':
        self.click_button('Later')
    if approve_on_form=='Y':
        self.fo_approve_in_popup(
            username=username,
            password=password,
            reason=reason
        )
    if list_error_message:
    # verify error
        self.assert_error_message()
        self.assert_list_error_message(list_error_message)
        print('Transaction failed!')
    else:
    # verify success
        self.assert_button_disable('Accept')
        self.switch_to_core_banking()
        self.assert_notification('Saved successfully!')
        self.close_voucher()
        if expected_posting:
            self.assert_posting_data(**expected_posting)
        transaction_references=self.fo_get_text('Transaction references')
        {{ "print(f'Transaction references " }} {{~ transaction_code ~}} {{ ": {transaction_references}')" }}
    {{~ list_return = "" ~}}
    {{~ for field in field_list ~}}
        {{~ fo_out_method = fo_get_out_method field.field_type field.is_group field.is_multi field.border_name ~}}
        {{~ method = choose_method fo_out_method ~}}
        {{~
        out_value = ""
        if field.return == "y"
            out_value = field.value | string.append "_out"
            list_return = list_return | string.append ", "  | string.append out_value
        ~}}
        {{ out_value }}=self.{{ method }}{{ "('" }}{{ field.title }}{{ "')" }}
        print(f'{{ field.title }}{{ ": {" }}{{ out_value }}{{ "}')" }}
        {{~ end ~}}
    {{~ end ~}}
        return transaction_references{{ list_return }}

