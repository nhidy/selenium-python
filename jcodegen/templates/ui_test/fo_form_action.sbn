        {{~ end ~}}
    {{~ end ~}}
{{~ end ~}}
    if expected_posting:
        self.assert_posting_data(**expected_posting)
{{~ for field in field_list ~}}
    {{~ fo_view_method = fo_get_view_method field.field_type field.is_group field.is_multi field.border_name ~}}
    {{~ method = choose_method fo_view_method ~}}
    {{~ if field.value == "" && field.title != "" && field.collap_name =="" ~}}
    self.{{ method }}('{{ field.title }}', True)
    {{~ end ~}}
{{~ end ~}}
    transaction_references=self.fo_get_text('Transaction references')
    {{ "print(f'F8: Transaction references " }} {{~ transaction_code ~}} {{ ": {transaction_references}')" }}
{{~ list_return = "" ~}}
{{~ for field in field_list ~}}
    {{~ fo_out_method = fo_get_out_method field.field_type field.is_group field.is_multi field.border_name ~}}
    {{~ method = choose_method fo_out_method ~}}
    {{~
    out_value = ""
    if field.return == "y"
        out_value = field.value | string.append "_out"
        list_return = list_return | string.append ", "  | string.append out_value
    ~}}
    {{ out_value }}=self.{{ method }}{{ "('" }}{{ field.title }}{{ "')" }}
    print(f'F8: {{ field.title }}{{ ": {" }}{{ out_value }}{{ "}')" }}
    {{~ end ~}}
{{~ end ~}}
    return transaction_references{{ list_return }}

{{~ test_case_name = form_title | regex.split `\d+:\s*` | array.last | string.downcase  | string.replace ` ` "_" | string.replace `-` "_" | string.replace `(` "" | string.replace `)` "" | string.replace `/` "_" ~}}
# TEST CASE: SUCCESS AND NO NEED APPROVE
def test_000_{{ transaction_code | string.downcase }}_{{ test_case_name }}_success_no_need_approve(self):
    print('Start: ' + datetime.now().strftime('%d/%m/%Y %H:%M:%S'))
{{~ list_param = "" ~}}
{{~ for field in field_list ~}}
    {{~
    if field.value != ""
        value_param = field.value | string.append "_test = None"
        list_param = list_param | string.append "    " | string.append value_param | string.append "\n"
    ~}}
    {{~ end ~}}
{{~ end ~}}
    {{~ list_param ~}}
    ifc_codes = None
    values = None
    total_fee = None
    expected_posting = None

    {{ transaction_code | string.downcase }}_result = self.{{ transaction_code | string.downcase }}(
{{~ list_param = "" ~}}
{{~ for field in field_list ~}}
    {{~
    if field.value != ""
        value_param = field.value | string.append "=" | string.append field.value | string.append "_test,\n"
        list_param = list_param | string.append "        " | string.append value_param
    ~}}
    {{~ end ~}}
{{~ end ~}}
        {{~ list_param ~}}
        ifc_codes=ifc_codes,
        values=values,
        total_fee=total_fee,
        expected_posting=expected_posting,
    )
    transaction_references={{ transaction_code | string.downcase }}_result[0]
{{~ list_return = "" ~}}
{{~ i = 1 ~}}
{{~ for field in field_list ~}}
    {{~
    out_value = ""
    if field.return == "y"
        out_value = field.value | string.append "_out="  | string.append transaction_code | string.downcase  | string.append "_result[" | string.append i | string.append "]\n"
        list_return = list_return | string.append "    " | string.append out_value
        i = i + 1
    end
    ~}}
{{~ end ~}}
    {{~ list_return ~}}
    self.{{ transaction_code | string.downcase }}_view(
        transaction_references=transaction_references,
{{~ list_param = "" ~}}
{{~ for field in field_list ~}}
    {{~
    if field.value != ""
        value_param = field.value | string.append "=" | string.append field.value | string.append "_test,\n"
        list_param = list_param | string.append "        " | string.append value_param
    ~}}
    {{~ end ~}}
{{~ end ~}}
        {{~ list_param ~}}
        expected_posting=expected_posting,
    )

