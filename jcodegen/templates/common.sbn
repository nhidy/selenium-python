{{~
func choose_param(field_method, method, title, value, collap_name, border_name, is_replace, replace_by, mask_method)
    param_string = ""
    value_covert = ""
    value_mask_covert = ""
    if is_replace == "y"
        value_covert = value_covert | string.append "str(" | string.append value | string.append ").replace('" | string.append replace_by | string.append "', '')"
    else
        value_covert = value
    end
    if mask_method != ""
        value_mask_covert = value_mask_covert | string.append "self." | string.append mask_method | string.append "(" | string.append value | string.append ")"
    else
        value_mask_covert = value
    end
    case field_method
        when "bgv", "bgvs", "bgvg", "bgvgs", "bgvd", "bgd", "bgds", "bgdg", "bgs", "bgss", "bgsm", "bgt", "bgts", "bgtg", "bgtgs", "bgtml", "bgtd", "bcc", "bccs", "fgv", "fgvg", "fgvd", "fgd", "fgs", "fgsm", "fgt", "fgtg", "fgtml", "fgtd", "fcc"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append title | string.append "')"
        when "bw", "bwdt", "bws", "bwg", "bwgs", "bwt", "bwtd", "bwts", "bwtg", "bwtgs", "bwtml", "bwd", "bwds", "bwn", "bwns", "bwng", "bwngs", "bsv", "bst", "fw", "fwg", "fwd", "fwn", "fwng", "fwt", "fwtg", "fwtml", "fsv", "fst"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
        when "bav", "bavs", "bavg", "bavgs", "bavd", "bad", "bads", "badg", "bas", "bass", "basg", "basgs", "basm", "bat", "bats", "batg", "batgs", "batml", "batd", "batd", "fav", "favg", "fad", "fas", "fasm", "fat", "fatg", "fatml", "fatd", "favd"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append title | string.append "', " | string.append value_mask_covert | string.append ")"
        when "bgsg", "bgsgs", "fgsg"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append title | string.append "', '" | string.append title_front_select | string.append "')"
        when "bgvb", "bgtb", "fgvb", "fgtb"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append border_name | string.append "', '" | string.append title | string.append "')"
        when "bwtb", "fwb", "fwdb", "fwnb", "fwtb"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append border_name | string.append "', '" | string.append title | string.append "', " | string.append value_covert | string.append ")"
        when "bavb", "batb", "favb", "fatb"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append border_name | string.append "', '" | string.append title | string.append "', " | string.append value_mask_covert | string.append ")"
        when "bccl", "bccls", "fccl"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append collap_name | string.append "')"
        when "fgvm", "fgtm"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self.fo_click_collap('" | string.append collap_name | string.append "')\n    self." | string.append method | string.append "('" | string.append collap_name | string.append "', '" | string.append title | string.append "')"
        when "bgvm", "bgtm", "bccm"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self.bo_click_collap('" | string.append collap_name | string.append "')\n    self." | string.append method | string.append "('" | string.append collap_name | string.append "', '" | string.append title | string.append "')"
        when "fwm", "fsc", "fwtm"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self.fo_click_collap('" | string.append collap_name | string.append "')\n    self." | string.append method | string.append "('" | string.append collap_name | string.append "', '" | string.append title | string.append "', " | string.append value_covert | string.append ")"
        when "bwm", "bwms", "bwtm", "bwtms", "bsc"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self.bo_click_collap('" | string.append collap_name | string.append "')\n    self." | string.append method | string.append "('" | string.append collap_name | string.append "', '" | string.append title | string.append "', " | string.append value_covert | string.append ")"
        when "favm", "fatm"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self.fo_click_collap('" | string.append collap_name | string.append "')\n    self." | string.append method | string.append "('" | string.append collap_name | string.append "', '" | string.append title | string.append "', " | string.append value_mask_covert | string.append ")"
        when "bavm", "batm", "bacm", "facm"
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self.bo_click_collap('" | string.append collap_name | string.append "')\n    self." | string.append method | string.append "('" | string.append collap_name | string.append "', '" | string.append title | string.append "', " | string.append value_mask_covert | string.append ")"
        when "bac", "fac"
            param_string = param_string | string.append "if " | string.append value | string.append " is not None:\n    self." | string.append method | string.append "('" | string.append title | string.append "', " | string.append value_mask_covert | string.append ")"
        when "bs", "bsd", "bss", "bsg", "bsgs", "bsm", "fs", "fsm", "fsd"
            param_string = param_string | string.append "self.key_escape()\nif " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
        when "bsb", "fsb"
            param_string = param_string | string.append "self.key_escape()\nif " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append border_name | string.append "', '" | string.append title | string.append "', " | string.append value_covert | string.append ")"
        else
            param_string = param_string | string.append "if " | string.append value | string.append ":\n    self." | string.append method | string.append "('" | string.append title | string.append "', '" | string.append title_front_select | string.append "', " | string.append value_covert | string.append ")"
    end
    ret param_string
end
~}}
{{~
func choose_name(transaction_code, form_name)
    name_string = ""
    if (transaction_code | string.ends_with "_Search")
        name_string = form_name | string.append "_simple_search"
    else if (transaction_code | string.ends_with "_advanced_search")
        name_string = form_name | string.append "_advanced_search"
    else if (transaction_code | string.ends_with "_Add")
        name_string = form_name | string.append "_add"
    else if (transaction_code | string.ends_with "_View")
        name_string = form_name | string.append "_view"
    else
        name_string = form_name | string.append "_view"
    end
    ret name_string
end
~}}

{{~
func choose_name_code_list(transaction_code, form_name)
    name_string = ""
    if (transaction_code | string.ends_with "_search")
        name_string = form_name | string.append "_simple_search"
    else if (transaction_code | string.ends_with "_search_advanced")
        name_string = form_name | string.append "_advanced_search"
    else if (transaction_code | string.ends_with "_add")
        name_string = form_name | string.append "_add"
    else if (transaction_code | string.ends_with "_Add")
        name_string = form_name | string.append "_add"
    else if (transaction_code | string.ends_with "_View")
        name_string = form_name | string.append "_view"
    else
        name_string = form_name | string.append "_view"
    end
    ret name_string
end
~}}
