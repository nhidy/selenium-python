{{~
func choose_advanced_search(title, value, field_type, is_group, is_replace, replace_by)
    advanced_search_string = ""
    value_covert = ""
    if is_replace == "y"
        value_covert = value_covert | string.append "str(" | string.append value | string.append ").replace('" | string.append replace_by | string.append "', '')"
    else
        value_covert = value
    end
    if (field_type == "input" && is_group == "")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_search('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "date" && is_group == "")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_search('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "number" && is_group == "")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_search('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "text" && is_group == "")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_search_text('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "select" && is_group == "")
        advanced_search_string = "self.key_escape()\nif " | string.append value | string.append ":\n    self.adv_search_select('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "checkbox" && is_group == "")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_click_checkbox('" | string.append title | string.append "')"
    else if (field_type == "input" && is_group == "y")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_search_group('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "date" && is_group == "y")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_search_group('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "number" && is_group == "y")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_search_group('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "text" && is_group == "y")
        advanced_search_string = "if " | string.append value | string.append ":\n    self.adv_search_text_group('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    else if (field_type == "select" && is_group == "y")
        advanced_search_string = "self.key_escape()\nif " | string.append value | string.append ":\n    self.adv_search_select_group('" | string.append title | string.append "', " | string.append value_covert | string.append ")"
    end
    ret advanced_search_string
end
~}}
