apiVersion: v1
kind: Service
metadata:
  name: cbs-autotest-service
  namespace: {{ namespace }}
  labels:
    app: cbs-autotest
spec:
  type: NodePort
  selector:
    app: cbs-autotest
  ports:
    - name: uvicorn
      port: 8000
      targetPort: 8000
      nodePort: 30038
      protocol: TCP
      